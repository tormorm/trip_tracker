---
// Top row for full-screen cards: close (left), instruction (right), hotel switcher.
import T from './T.astro';
import type { UiKey } from '../i18n/ui';
import { trip } from '../lib/data';
interface Props {
  instruction: UiKey;
  inverse?: boolean;
}
const { instruction, inverse = false } = Astro.props;
---
<div class:list={['chrome', { inverse }]}>
  <button type="button" class="x" data-close aria-label="Sulge / Close">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M5 5l14 14M19 5 5 19" /></svg>
  </button>
  <label class="pick">
    <span class="sr"><T k="card.pickHotel" /></span>
    <select data-hotel-select>
      {trip.stops.map((s) => <option value={s.id}>{s.name}</option>)}
    </select>
  </label>
  <span class="instr"><T k={instruction} /></span>
</div>

<style>
  .chrome { display: flex; align-items: center; gap: 8px; padding: 8px 12px 6px; padding-top: calc(8px + env(safe-area-inset-top)); }
  .x { width: 48px; height: 48px; border: 0; background: none; color: inherit; display: grid; place-items: center; cursor: pointer; flex: none; }
  .pick select {
    min-height: 40px; max-width: 150px; border: 1.5px solid currentColor; border-radius: 999px; background: transparent;
    color: inherit; font: 700 14px var(--font); padding: 0 10px;
  }
  .instr { margin-left: auto; font-weight: 800; font-size: 14px; text-align: right; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
