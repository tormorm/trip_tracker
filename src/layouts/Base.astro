---
import '../styles/global.css';
import TabBar from '../components/TabBar.astro';
import PlaceholderBanner from '../components/PlaceholderBanner.astro';
import { DEFAULT_LANG } from '../i18n/ui';

interface Props {
  title: string;
  /** Overlays/full-screen pages hide the tab bar. */
  tabs?: boolean;
  /** Full-height app screen (map): no page scroll. */
  fullscreen?: boolean;
}
const { title, tabs = true, fullscreen = false } = Astro.props;
---
<!doctype html>
<html lang={DEFAULT_LANG} data-lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3eadb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120e" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <script is:inline>
      try {
        var l = localStorage.getItem('tc.lang');
        if (l === 'et' || l === 'en') { document.documentElement.dataset.lang = l; document.documentElement.lang = l; }
      } catch (e) {}
      (function () {
        var upd = function () { document.documentElement.classList.toggle('is-offline', !navigator.onLine); };
        upd(); addEventListener('online', upd); addEventListener('offline', upd);
      })();
    </script>
  </head>
  <body class:list={{ fullscreen }}>
    <PlaceholderBanner />
    <slot />
    {tabs && <TabBar />}
  </body>
</html>
