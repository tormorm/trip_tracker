# Only used where Apache serves the files. On Plesk, nginx usually serves static
# files directly and ignores this file; the app works either way.
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
  # Hashed build assets never change.
  <FilesMatch "^.+\.[0-9A-Za-z_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always check for a new service worker / pages.
  <FilesMatch "(sw\.js|sw-tiles\.js|workbox-.*\.js|\.html|\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
