---
import T from './T.astro';
import type { Day } from '../data/schema';
import { trip, placeById } from '../lib/data';
import { fmtWeekday } from '../lib/time';
import { dayNumber } from '../lib/trip';

interface Props {
  day: Day;
}
const { day } = Astro.props;
const n = dayNumber(trip, day.date);
const transfers = trip.transfers.filter((t) => t.date === day.date);
const placesToday = day.items.flatMap((i) => (i.placeId ? [placeById.get(i.placeId)!] : []));
---
<article class="day" id={`d-${day.date}`} data-date={day.date}>
  <span class="badge"><T k="today" /></span>
  <div class="date">
    <span class="wd"><T v={fmtWeekday(day.date)} /></span>
    <span class="num">{Number(day.date.slice(8))}</span>
    <span class="dn"><span data-l="et">{n}. PÄEV</span><span data-l="en">DAY {n}</span></span>
  </div>
  <div class="body">
    <h3><T v={day.title} /></h3>
    {transfers.map((t) => <p class="sub">{t.time} · <T k={`mode.${t.mode}`} /> · <T v={t.detail} /></p>)}
    {placesToday.length > 0 && (
      <ul class="chips">
        {placesToday.map((p) => (
          <li><a href={`/map/?place=${p.id}`}><span class:list={['mk', `mk-${p.tier}`]} />{p.name}</a></li>
        ))}
      </ul>
    )}
    {day.note && <p class="aside note"><T v={day.note} /></p>}
  </div>
</article>

<style>
  .day {
    position: relative; display: grid; grid-template-columns: 64px 1fr; gap: 14px;
    background: var(--card); border: 1.5px solid var(--hair); border-radius: var(--radius-lg);
    padding: 14px 16px; margin: 10px 0; scroll-margin-top: 16px;
  }
  .date { display: flex; flex-direction: column; align-items: center; border-right: 1.5px dashed var(--hair); padding-right: 12px; }
  .wd { font-weight: 800; font-size: 13px; }
  .num { font-size: 30px; font-weight: 800; line-height: 1; }
  .dn { font-size: 11px; font-weight: 800; color: var(--ink-2); letter-spacing: 0.04em; margin-top: 2px; text-align: center; }
  h3 { font-size: 18px; font-weight: 800; line-height: 1.25; }
  .sub { margin: 4px 0 0; font-size: 14px; color: var(--ink-2); }
  .note { margin: 6px 0 0; font-size: 16px; }
  .chips { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 10px;
    background: var(--fill); border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;
  }
  .mk { width: 10px; height: 10px; flex: none; }
  .mk-popular { border-radius: 50%; background: var(--lacquer); }
  .mk-hidden { width: 9px; height: 9px; transform: rotate(45deg); background: var(--jade); }
  .badge { display: none; }
  .day:global(.is-today) { border: 2.5px solid var(--lacquer); }
  .day:global(.is-today) .wd { color: var(--lacquer); }
  .day:global(.is-today) .badge {
    display: block; position: absolute; top: -11px; right: 14px;
    background: var(--lacquer); color: var(--lacquer-ink); border-radius: 6px;
    padding: 1px 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .day:global(.is-past) { opacity: 0.6; }
</style>
