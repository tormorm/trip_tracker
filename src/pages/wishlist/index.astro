---
import Base from '../../layouts/Base.astro';
import LangToggle from '../../components/LangToggle.astro';
import WishlistView from '../../components/react/WishlistView';
import { trip } from '../../lib/data';

const stops = trip.stops.map(({ id, name, lat, lng, arrive, depart }) => ({ id, name, lat, lng, arrive, depart }));
const travellers = trip.travellers.map(({ name, color }) => ({ name, color }));
---
<Base title="Soovid · Wishlist">
  <main class="page">
    <div class="corner"><LangToggle /></div>
    <WishlistView client:load travellers={travellers} stops={stops} startDate={trip.startDate} endDate={trip.endDate} />
  </main>
</Base>
